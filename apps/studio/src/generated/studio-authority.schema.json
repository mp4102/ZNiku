{
  "$defs": {
    "ArtifactType": {
      "description": "Artifact 的顶层语义类别。",
      "enum": [
        "media",
        "metadata",
        "control"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "Cardinality": {
      "description": "端口绑定单值、可选单值或正式集合。",
      "enum": [
        "one",
        "optional",
        "set"
      ],
      "title": "Cardinality",
      "type": "string"
    },
    "ChapterMemberBinding": {
      "additionalProperties": false,
      "description": "把稳定章节成员身份绑定到 scope target 与连续 coverage。",
      "properties": {
        "coverage": {
          "$ref": "#/$defs/CoverageSpan"
        },
        "member_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Member Id",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Scope Id",
          "type": "string"
        }
      },
      "required": [
        "member_id",
        "scope_id",
        "coverage"
      ],
      "title": "ChapterMemberBinding",
      "type": "object"
    },
    "CoreOperatorKind": {
      "description": "首版闭合的 Runtime 图操作集合。",
      "enum": [
        "partition",
        "map",
        "select",
        "passthrough",
        "collect",
        "reduce"
      ],
      "title": "CoreOperatorKind",
      "type": "string"
    },
    "CoreOperatorNodeSpec": {
      "additionalProperties": false,
      "description": "WorkflowSpec 中一个不执行媒体算法的 Core Operator node。",
      "properties": {
        "engine": {
          "anyOf": [
            {
              "$ref": "#/$defs/EngineBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "core_operator",
          "title": "Kind",
          "type": "string"
        },
        "media_kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "operator_kind": {
          "$ref": "#/$defs/CoreOperatorKind"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "selected_member_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "title": "Selected Member Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "node_id",
        "operator_kind",
        "media_kind"
      ],
      "title": "CoreOperatorNodeSpec",
      "type": "object"
    },
    "CoverageSpan": {
      "additionalProperties": false,
      "description": "使用左闭右开整数区间表达一段精确覆盖。",
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "unit": {
          "$ref": "#/$defs/CoverageUnit"
        }
      },
      "required": [
        "unit",
        "start",
        "end"
      ],
      "title": "CoverageSpan",
      "type": "object"
    },
    "CoverageUnit": {
      "description": "集合覆盖区间使用的精确整数单位。",
      "enum": [
        "frame",
        "microsecond",
        "item"
      ],
      "title": "CoverageUnit",
      "type": "string"
    },
    "EngineBinding": {
      "additionalProperties": false,
      "description": "将 StageRun 固定到精确 Engine 版本与 manifest digest。",
      "properties": {
        "engine_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
          "title": "Engine Id",
          "type": "string"
        },
        "engine_version": {
          "maxLength": 128,
          "minLength": 5,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
          "title": "Engine Version",
          "type": "string"
        },
        "manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        }
      },
      "required": [
        "engine_id",
        "engine_version",
        "manifest_digest"
      ],
      "title": "EngineBinding",
      "type": "object"
    },
    "EngineInputContract": {
      "additionalProperties": false,
      "description": "将输入 PortSpec 与 Artifact 属性前置条件绑定。",
      "properties": {
        "port": {
          "$ref": "#/$defs/PortSpec"
        },
        "preconditions_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Preconditions Schema",
          "type": "object"
        }
      },
      "required": [
        "port"
      ],
      "title": "EngineInputContract",
      "type": "object"
    },
    "EngineLifecycleCapabilities": {
      "additionalProperties": false,
      "description": "显式声明 Engine 是否提供验收、发布与恢复集成能力。",
      "properties": {
        "supports_acceptance": {
          "title": "Supports Acceptance",
          "type": "boolean"
        },
        "supports_publication": {
          "title": "Supports Publication",
          "type": "boolean"
        },
        "supports_recovery": {
          "title": "Supports Recovery",
          "type": "boolean"
        }
      },
      "required": [
        "supports_acceptance",
        "supports_publication",
        "supports_recovery"
      ],
      "title": "EngineLifecycleCapabilities",
      "type": "object"
    },
    "EngineOutputContract": {
      "additionalProperties": false,
      "description": "将输出 PortSpec、Artifact 属性保证和媒体属性变化声明绑定。",
      "properties": {
        "attribute_rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MediaAttributeRule"
          },
          "title": "Attribute Rules",
          "type": "array"
        },
        "guarantees_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Guarantees Schema",
          "type": "object"
        },
        "port": {
          "$ref": "#/$defs/PortSpec"
        }
      },
      "required": [
        "port"
      ],
      "title": "EngineOutputContract",
      "type": "object"
    },
    "EngineStageNodeSpec": {
      "additionalProperties": false,
      "description": "保存 Engine-backed Stage 的精确 manifest 绑定和惰性参数。",
      "properties": {
        "engine": {
          "$ref": "#/$defs/EngineBinding"
        },
        "kind": {
          "const": "engine_stage",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "node_id",
        "engine",
        "parameters"
      ],
      "title": "EngineStageNodeSpec",
      "type": "object"
    },
    "ExecutionMode": {
      "description": "首批 Engine 执行方式；远程执行尚未进入合同。",
      "enum": [
        "automatic",
        "manual_external"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "FinalNodeSpec": {
      "additionalProperties": false,
      "description": "表示唯一终端类别；本阶段只校验其静态 program input。",
      "properties": {
        "kind": {
          "const": "final",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node_id"
      ],
      "title": "FinalNodeSpec",
      "type": "object"
    },
    "JsonValue": {},
    "MediaAttributeDisposition": {
      "description": "Engine 对某个输出媒体属性的声明。",
      "enum": [
        "preserved",
        "changed",
        "not_guaranteed"
      ],
      "title": "MediaAttributeDisposition",
      "type": "string"
    },
    "MediaAttributeRule": {
      "additionalProperties": false,
      "description": "说明一个输出属性保持、改变或无法保证。",
      "properties": {
        "disposition": {
          "$ref": "#/$defs/MediaAttributeDisposition"
        },
        "path": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
          "title": "Path",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaAttributeSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "path",
        "disposition"
      ],
      "title": "MediaAttributeRule",
      "type": "object"
    },
    "MediaAttributeSource": {
      "additionalProperties": false,
      "description": "指出输出属性声明所引用的直接输入端口与属性路径。",
      "properties": {
        "path": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
          "title": "Path",
          "type": "string"
        },
        "port_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Port Id",
          "type": "string"
        }
      },
      "required": [
        "port_id",
        "path"
      ],
      "title": "MediaAttributeSource",
      "type": "object"
    },
    "MediaKind": {
      "description": "媒体 Artifact 的首批受控媒体类别。",
      "enum": [
        "program_media",
        "video",
        "audio",
        "subtitle",
        "attachment"
      ],
      "title": "MediaKind",
      "type": "string"
    },
    "NodeRunRecord": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "evidence_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "plan_node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Plan Node Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/NodeRunState"
        }
      },
      "required": [
        "plan_node_id",
        "state",
        "attempt"
      ],
      "title": "NodeRunRecord",
      "type": "object"
    },
    "NodeRunState": {
      "enum": [
        "blocked",
        "ready",
        "running",
        "complete",
        "failed"
      ],
      "title": "NodeRunState",
      "type": "string"
    },
    "PlannedSubjectKind": {
      "enum": [
        "source",
        "engine",
        "operator",
        "final"
      ],
      "title": "PlannedSubjectKind",
      "type": "string"
    },
    "PortEndpoint": {
      "additionalProperties": false,
      "description": "用稳定 node ID 与 port ID 引用一侧端口。",
      "properties": {
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "port_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Port Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "port_id"
      ],
      "title": "PortEndpoint",
      "type": "object"
    },
    "PortSpec": {
      "additionalProperties": false,
      "description": "Engine 端口的稳定 ID、类型、scope 与基数声明。",
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "cardinality": {
          "$ref": "#/$defs/Cardinality"
        },
        "media_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "port_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Port Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "port_id",
        "artifact_type",
        "media_kind",
        "scope",
        "cardinality"
      ],
      "title": "PortSpec",
      "type": "object"
    },
    "Scope": {
      "description": "Artifact 或 Engine 端口的处理范围。",
      "enum": [
        "program",
        "chapter",
        "leaf"
      ],
      "title": "Scope",
      "type": "string"
    },
    "SourceNodeSpec": {
      "additionalProperties": false,
      "description": "表示一个尚未绑定真实媒体的 program source slot。",
      "properties": {
        "kind": {
          "const": "source",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node_id"
      ],
      "title": "SourceNodeSpec",
      "type": "object"
    },
    "StageEvidence": {
      "additionalProperties": false,
      "description": "合成 Runtime 对一次 planned node 验证完成的最小证据。",
      "properties": {
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "output_identity": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Output Identity",
          "type": "string"
        },
        "plan_node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Plan Node Id",
          "type": "string"
        },
        "verified": {
          "const": true,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "evidence_id",
        "plan_node_id",
        "attempt",
        "verified",
        "output_identity"
      ],
      "title": "StageEvidence",
      "type": "object"
    },
    "WorkflowEdgeSpec": {
      "additionalProperties": false,
      "description": "表示一条 output→input Artifact 数据边。",
      "properties": {
        "edge_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Edge Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PortEndpoint"
        },
        "target": {
          "$ref": "#/$defs/PortEndpoint"
        }
      },
      "required": [
        "edge_id",
        "source",
        "target"
      ],
      "title": "WorkflowEdgeSpec",
      "type": "object"
    },
    "WorkflowNodeSpec": {
      "oneOf": [
        {
          "$ref": "#/$defs/SourceNodeSpec"
        },
        {
          "$ref": "#/$defs/EngineStageNodeSpec"
        },
        {
          "$ref": "#/$defs/CoreOperatorNodeSpec"
        },
        {
          "$ref": "#/$defs/FinalNodeSpec"
        }
      ]
    }
  },
  "$id": "urn:zniku:schema:studio-authority:0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Phase 5 默认流程的完整只读 Studio authority bundle。",
  "properties": {
    "chapter_plan": {
      "additionalProperties": false,
      "description": "Preflight 使用的有序、完整章节 authority。",
      "properties": {
        "chapter_plan_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Chapter Plan Id",
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/CoverageSpan"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/ChapterMemberBinding"
          },
          "title": "Members",
          "type": "array"
        }
      },
      "required": [
        "chapter_plan_id",
        "members",
        "coverage"
      ],
      "title": "ChapterPlan",
      "type": "object"
    },
    "execution_plan": {
      "additionalProperties": false,
      "description": "Compiler 根据完整 authority 产生的不可变、确定性执行图。",
      "properties": {
        "binding_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Binding Digest",
          "type": "string"
        },
        "core_operator_contract_version": {
          "const": "0.1.0",
          "title": "Core Operator Contract Version",
          "type": "string"
        },
        "execution_plan_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Execution Plan Id",
          "type": "string"
        },
        "nodes": {
          "items": {
            "additionalProperties": false,
            "description": "ExecutionPlan 中一个确定 scope 的执行主体。",
            "properties": {
              "dependencies": {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                  "type": "string"
                },
                "title": "Dependencies",
                "type": "array"
              },
              "engine": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/EngineBinding"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "operator_kind": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/CoreOperatorKind"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "parameters": {
                "additionalProperties": {
                  "$ref": "#/$defs/JsonValue"
                },
                "title": "Parameters",
                "type": "object"
              },
              "plan_node_id": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                "title": "Plan Node Id",
                "type": "string"
              },
              "scope": {
                "$ref": "#/$defs/Scope"
              },
              "scope_id": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                "title": "Scope Id",
                "type": "string"
              },
              "stage_spec_id": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                "title": "Stage Spec Id",
                "type": "string"
              },
              "subject_kind": {
                "$ref": "#/$defs/PlannedSubjectKind"
              }
            },
            "required": [
              "plan_node_id",
              "stage_spec_id",
              "subject_kind",
              "scope",
              "scope_id",
              "dependencies"
            ],
            "title": "PlannedNode",
            "type": "object"
          },
          "title": "Nodes",
          "type": "array"
        },
        "plan_contract_version": {
          "const": "0.1.0",
          "title": "Plan Contract Version",
          "type": "string"
        },
        "workflow_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Workflow Id",
          "type": "string"
        },
        "workflow_spec_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Workflow Spec Digest",
          "type": "string"
        }
      },
      "required": [
        "plan_contract_version",
        "execution_plan_id",
        "workflow_id",
        "workflow_spec_digest",
        "binding_digest",
        "core_operator_contract_version",
        "nodes"
      ],
      "title": "ExecutionPlan",
      "type": "object"
    },
    "manifests": {
      "items": {
        "additionalProperties": false,
        "description": "Engine 身份、版本、端口、scope、参数与声明式媒体能力的唯一合同。",
        "properties": {
          "contract_version": {
            "const": "0.1.0",
