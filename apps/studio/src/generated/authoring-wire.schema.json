{
  "$defs": {
    "AddEngineStageNodeIntent": {
      "additionalProperties": false,
      "description": "请求 Python 分配一个 EngineStage node ID。",
      "properties": {
        "engine": {
          "$ref": "#/$defs/EngineBinding"
        },
        "intent_kind": {
          "const": "add_engine_stage_node",
          "title": "Intent Kind",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "intent_kind",
        "engine",
        "parameters"
      ],
      "title": "AddEngineStageNodeIntent",
      "type": "object"
    },
    "AddFinalNodeIntent": {
      "additionalProperties": false,
      "description": "请求 Python 分配一个 Final node ID。",
      "properties": {
        "intent_kind": {
          "const": "add_final_node",
          "title": "Intent Kind",
          "type": "string"
        }
      },
      "required": [
        "intent_kind"
      ],
      "title": "AddFinalNodeIntent",
      "type": "object"
    },
    "AddSourceNodeIntent": {
      "additionalProperties": false,
      "description": "请求 Python 分配一个 Source node ID。",
      "properties": {
        "intent_kind": {
          "const": "add_source_node",
          "title": "Intent Kind",
          "type": "string"
        }
      },
      "required": [
        "intent_kind"
      ],
      "title": "AddSourceNodeIntent",
      "type": "object"
    },
    "AuthoringCommand": {
      "additionalProperties": false,
      "description": "针对一个精确 Draft revision 的原子 typed edit intent。",
      "properties": {
        "authoring_contract_version": {
          "const": "0.1.0",
          "title": "Authoring Contract Version",
          "type": "string"
        },
        "base_revision": {
          "minimum": 0,
          "title": "Base Revision",
          "type": "integer"
        },
        "command_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Command Id",
          "type": "string"
        },
        "draft_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Draft Id",
          "type": "string"
        },
        "intent": {
          "$ref": "#/$defs/AuthoringIntent"
        }
      },
      "required": [
        "authoring_contract_version",
        "command_id",
        "draft_id",
        "base_revision",
        "intent"
      ],
      "title": "AuthoringCommand",
      "type": "object"
    },
    "AuthoringCommandRejected": {
      "additionalProperties": false,
      "description": "已解析命令因幂等、revision 或原子应用规则被拒绝。",
      "properties": {
        "authoring_contract_version": {
          "const": "0.1.0",
          "title": "Authoring Contract Version",
          "type": "string"
        },
        "base_revision": {
          "minimum": 0,
          "title": "Base Revision",
          "type": "integer"
        },
        "command_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Command Id",
          "type": "string"
        },
        "current_revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Revision"
        },
        "diagnostic_contract_version": {
          "const": "0.1.0",
          "title": "Diagnostic Contract Version",
          "type": "string"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "draft_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Draft Id",
          "type": "string"
        },
        "result_kind": {
          "const": "command_rejected",
          "title": "Result Kind",
          "type": "string"
        }
      },
      "required": [
        "result_kind",
        "authoring_contract_version",
        "diagnostic_contract_version",
        "command_id",
        "draft_id",
        "base_revision",
        "diagnostics"
      ],
      "title": "AuthoringCommandRejected",
      "type": "object"
    },
    "AuthoringIntent": {
      "oneOf": [
        {
          "$ref": "#/$defs/AddSourceNodeIntent"
        },
        {
          "$ref": "#/$defs/AddEngineStageNodeIntent"
        },
        {
          "$ref": "#/$defs/AddFinalNodeIntent"
        },
        {
          "$ref": "#/$defs/DeleteNodeIntent"
        },
        {
          "$ref": "#/$defs/ConnectPortsIntent"
        },
        {
          "$ref": "#/$defs/DisconnectPortsIntent"
        },
        {
          "$ref": "#/$defs/ReplaceEngineBindingIntent"
        },
        {
          "$ref": "#/$defs/ReplaceParametersIntent"
        }
      ]
    },
    "CommandEntityRef": {
      "additionalProperties": false,
      "description": "定位 authoring command 或其字段。",
      "properties": {
        "command_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Id"
        },
        "json_pointer": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 0,
              "pattern": "^(?:/[^\\r\\n]*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Pointer"
        },
        "kind": {
          "const": "command",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CommandEntityRef",
      "type": "object"
    },
    "ConnectPortsIntent": {
      "additionalProperties": false,
      "description": "请求 Python 分配 edge ID 并连接两个稳定 endpoint。",
      "properties": {
        "intent_kind": {
          "const": "connect_ports",
          "title": "Intent Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PortEndpoint"
        },
        "target": {
          "$ref": "#/$defs/PortEndpoint"
        }
      },
      "required": [
        "intent_kind",
        "source",
        "target"
      ],
      "title": "ConnectPortsIntent",
      "type": "object"
    },
    "DeleteNodeIntent": {
      "additionalProperties": false,
      "description": "删除 node 及与之相连的 edge。",
      "properties": {
        "intent_kind": {
          "const": "delete_node",
          "title": "Intent Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "intent_kind",
        "node_id"
      ],
      "title": "DeleteNodeIntent",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "description": "用稳定 identity、code 和 typed entity reference 表达一个 Python 结论。",
      "properties": {
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "diagnostic_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Diagnostic Id",
          "type": "string"
        },
        "entity_ref": {
          "$ref": "#/$defs/EntityRef"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "occurrence_key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Occurrence Key",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/DiagnosticPhase"
        },
        "related_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "title": "Related Refs",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity"
        },
        "stable_code": {
          "maxLength": 96,
          "minLength": 3,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Stable Code",
          "type": "string"
        },
        "suggested_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/SuggestedAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "diagnostic_id",
        "stable_code",
        "occurrence_key",
        "severity",
        "phase",
        "entity_ref",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "DiagnosticPhase": {
      "description": "诊断产生的权威边界。",
      "enum": [
        "parse",
        "authoring",
        "graph",
        "manifest"
      ],
      "title": "DiagnosticPhase",
      "type": "string"
    },
    "DiagnosticSeverity": {
      "description": "诊断严重级别；只有 error 阻断 authoring-valid。",
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "DiagnosticSeverity",
      "type": "string"
    },
    "DisconnectPortsIntent": {
      "additionalProperties": false,
      "description": "按稳定 edge ID 断开一条数据边。",
      "properties": {
        "edge_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Edge Id",
          "type": "string"
        },
        "intent_kind": {
          "const": "disconnect_ports",
          "title": "Intent Kind",
          "type": "string"
        }
      },
      "required": [
        "intent_kind",
        "edge_id"
      ],
      "title": "DisconnectPortsIntent",
      "type": "object"
    },
    "DocumentEntityRef": {
      "additionalProperties": false,
      "description": "定位尚未形成正式领域对象的 wire document。",
      "properties": {
        "json_pointer": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 0,
              "pattern": "^(?:/[^\\r\\n]*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Pointer"
        },
        "kind": {
          "const": "document",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DocumentEntityRef",
      "type": "object"
    },
    "DraftValidationEnvelope": {
      "additionalProperties": false,
      "description": "由 Authoring service 将纯 Compiler 结果绑定到 Draft revision。",
      "properties": {
        "authoring_contract_version": {
          "const": "0.1.0",
          "title": "Authoring Contract Version",
          "type": "string"
        },
        "draft_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Draft Id",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/SpecValidationResult"
        },
        "subject_revision": {
          "minimum": 0,
          "title": "Subject Revision",
          "type": "integer"
        }
      },
      "required": [
        "authoring_contract_version",
        "draft_id",
        "subject_revision",
        "result"
      ],
      "title": "DraftValidationEnvelope",
      "type": "object"
    },
    "EdgeEntityRef": {
      "additionalProperties": false,
      "description": "定位一条稳定 edge。",
      "properties": {
        "edge_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Edge Id",
          "type": "string"
        },
        "kind": {
          "const": "edge",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "edge_id"
      ],
      "title": "EdgeEntityRef",
      "type": "object"
    },
    "EngineBinding": {
      "additionalProperties": false,
      "description": "将 StageRun 固定到精确 Engine 版本与 manifest digest。",
      "properties": {
        "engine_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
          "title": "Engine Id",
          "type": "string"
        },
        "engine_version": {
          "maxLength": 128,
          "minLength": 5,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
          "title": "Engine Version",
          "type": "string"
        },
        "manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        }
      },
      "required": [
        "engine_id",
        "engine_version",
        "manifest_digest"
      ],
      "title": "EngineBinding",
      "type": "object"
    },
    "EngineStageNodeSpec": {
      "additionalProperties": false,
      "description": "保存 Engine-backed Stage 的精确 manifest 绑定和惰性参数。",
      "properties": {
        "engine": {
          "$ref": "#/$defs/EngineBinding"
        },
        "kind": {
          "const": "engine_stage",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "node_id",
        "engine",
        "parameters"
      ],
      "title": "EngineStageNodeSpec",
      "type": "object"
    },
    "EntityRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/DocumentEntityRef"
        },
        {
          "$ref": "#/$defs/CommandEntityRef"
        },
        {
          "$ref": "#/$defs/WorkflowEntityRef"
        },
        {
          "$ref": "#/$defs/NodeEntityRef"
        },
        {
          "$ref": "#/$defs/PortEntityRef"
        },
        {
          "$ref": "#/$defs/EdgeEntityRef"
        },
        {
          "$ref": "#/$defs/ParameterEntityRef"
        }
      ]
    },
    "FinalNodeSpec": {
      "additionalProperties": false,
      "description": "表示唯一终端类别；本阶段只校验其静态 program input。",
      "properties": {
        "kind": {
          "const": "final",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node_id"
      ],
      "title": "FinalNodeSpec",
      "type": "object"
    },
    "JsonValue": {},
    "NodeEntityRef": {
      "additionalProperties": false,
      "description": "定位一个稳定 node。",
      "properties": {
        "kind": {
          "const": "node",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node_id"
      ],
      "title": "NodeEntityRef",
      "type": "object"
    },
    "ParameterEntityRef": {
      "additionalProperties": false,
      "description": "定位 EngineStage 参数 JSON Pointer。",
      "properties": {
        "json_pointer": {
          "default": "",
          "maxLength": 512,
          "minLength": 0,
          "pattern": "^(?:/[^\\r\\n]*)?$",
          "title": "Json Pointer",
          "type": "string"
        },
        "kind": {
          "const": "parameter",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node_id"
      ],
      "title": "ParameterEntityRef",
      "type": "object"
    },
    "PortDirection": {
      "description": "端口引用方向；PortSpec 本身不重复保存 direction。",
      "enum": [
        "input",
        "output"
      ],
      "title": "PortDirection",
      "type": "string"
    },
    "PortEndpoint": {
      "additionalProperties": false,
      "description": "用稳定 node ID 与 port ID 引用一侧端口。",
      "properties": {
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "port_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Port Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "port_id"
      ],
      "title": "PortEndpoint",
      "type": "object"
    },
    "PortEntityRef": {
      "additionalProperties": false,
      "description": "定位 node 的 input 或 output port。",
      "properties": {
        "direction": {
          "$ref": "#/$defs/PortDirection"
        },
        "kind": {
          "const": "port",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "port_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Port Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node_id",
        "port_id",
        "direction"
      ],
      "title": "PortEntityRef",
      "type": "object"
    },
    "ReplaceEngineBindingIntent": {
      "additionalProperties": false,
      "description": "替换 EngineStage 的精确 manifest binding。",
      "properties": {
        "engine": {
          "$ref": "#/$defs/EngineBinding"
        },
        "intent_kind": {
          "const": "replace_engine_binding",
          "title": "Intent Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "intent_kind",
        "node_id",
        "engine"
      ],
      "title": "ReplaceEngineBindingIntent",
      "type": "object"
    },
    "ReplaceParametersIntent": {
      "additionalProperties": false,
      "description": "原子替换 EngineStage 的完整惰性参数对象。",
      "properties": {
        "intent_kind": {
          "const": "replace_parameters",
          "title": "Intent Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "intent_kind",
        "node_id",
        "parameters"
      ],
      "title": "ReplaceParametersIntent",
      "type": "object"
    },
    "SourceNodeSpec": {
      "additionalProperties": false,
      "description": "表示一个尚未绑定真实媒体的 program source slot。",
      "properties": {
        "kind": {
          "const": "source",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node_id"
      ],
      "title": "SourceNodeSpec",
      "type": "object"
    },
    "SpecValidationResult": {
      "additionalProperties": false,
      "description": "纯 Compiler 结果；不感知 Draft，也不复制 WorkflowSpec。",
      "properties": {
        "compiler_contract_version": {
          "const": "0.1.0",
          "title": "Compiler Contract Version",
          "type": "string"
        },
        "core_node_contract_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Core Node Contract Digest",
          "type": "string"
        },
        "diagnostic_contract_version": {
          "const": "0.1.0",
          "title": "Diagnostic Contract Version",
          "type": "string"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/ValidationOutcome"
        },
        "spec_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Spec Digest",
          "type": "string"
        },
        "workflow_contract_version": {
          "const": "0.1.0",
          "title": "Workflow Contract Version",
          "type": "string"
        }
      },
      "required": [
        "workflow_contract_version",
        "compiler_contract_version",
        "diagnostic_contract_version",
        "spec_digest",
        "core_node_contract_digest",
        "outcome",
        "diagnostics"
      ],
      "title": "SpecValidationResult",
      "type": "object"
    },
    "SuggestedAction": {
      "additionalProperties": false,
      "description": "首版只允许刷新 authority；不得承载任意命令。",
      "properties": {
        "action": {
          "const": "refresh_authority",
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "SuggestedAction",
      "type": "object"
    },
    "ValidationOutcome": {
      "description": "Compiler 静态 authoring gate 的权威结论。",
      "enum": [
        "invalid",
        "authoring_valid"
      ],
      "title": "ValidationOutcome",
      "type": "string"
    },
    "WireParseFailure": {
      "additionalProperties": false,
      "description": "raw payload 无法形成 typed command 或 WorkflowSpec 时的稳定 wire 结果。",
      "properties": {
        "authoring_contract_version": {
          "const": "0.1.0",
          "title": "Authoring Contract Version",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "diagnostic_contract_version": {
          "const": "0.1.0",
          "title": "Diagnostic Contract Version",
          "type": "string"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "result_kind": {
          "const": "wire_parse_failure",
          "title": "Result Kind",
          "type": "string"
        }
      },
      "required": [
        "result_kind",
        "authoring_contract_version",
        "diagnostic_contract_version",
        "diagnostics"
      ],
      "title": "WireParseFailure",
      "type": "object"
    },
    "WorkflowDraftSnapshot": {
      "additionalProperties": false,
      "description": "Authoring service 返回的唯一 Draft authority snapshot。",
      "properties": {
        "authoring_contract_version": {
          "const": "0.1.0",
          "title": "Authoring Contract Version",
          "type": "string"
        },
        "draft_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Draft Id",
          "type": "string"
        },
        "result_kind": {
          "const": "draft_snapshot",
          "title": "Result Kind",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/WorkflowSpec"
        },
        "spec_revision": {
          "minimum": 0,
          "title": "Spec Revision",
          "type": "integer"
        },
        "validation": {
          "$ref": "#/$defs/DraftValidationEnvelope"
        }
      },
      "required": [
        "result_kind",
        "authoring_contract_version",
        "draft_id",
        "spec_revision",
        "spec",
        "validation"
      ],
      "title": "WorkflowDraftSnapshot",
      "type": "object"
    },
    "WorkflowEdgeSpec": {
      "additionalProperties": false,
      "description": "表示一条 output→input Artifact 数据边。",
      "properties": {
        "edge_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Edge Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PortEndpoint"
        },
        "target": {
          "$ref": "#/$defs/PortEndpoint"
        }
      },
      "required": [
        "edge_id",
        "source",
        "target"
      ],
      "title": "WorkflowEdgeSpec",
      "type": "object"
    },
    "WorkflowEntityRef": {
      "additionalProperties": false,
      "description": "定位整个 WorkflowSpec。",
      "properties": {
        "kind": {
          "const": "workflow",
          "title": "Kind",
          "type": "string"
        },
        "workflow_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "workflow_id"
      ],
      "title": "WorkflowEntityRef",
      "type": "object"
    },
    "WorkflowNodeSpec": {
      "oneOf": [
        {
          "$ref": "#/$defs/SourceNodeSpec"
        },
        {
          "$ref": "#/$defs/EngineStageNodeSpec"
        },
        {
          "$ref": "#/$defs/FinalNodeSpec"
        }
      ]
    },
    "WorkflowSpec": {
      "additionalProperties": false,
      "description": "保存与 Studio 布局无关、按稳定 ID 归一化的语义编排图。",
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/WorkflowEdgeSpec"
          },
          "title": "Edges",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/WorkflowNodeSpec"
          },
          "title": "Nodes",
          "type": "array"
        },
        "workflow_contract_version": {
          "const": "0.1.0",
          "title": "Workflow Contract Version",
          "type": "string"
        },
        "workflow_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_contract_version",
        "workflow_id",
        "nodes",
        "edges"
      ],
      "title": "WorkflowSpec",
      "type": "object"
    }
  },
  "$id": "urn:zniku:schema:authoring-wire:0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/AuthoringCommand"
    },
    {
      "$ref": "#/$defs/WorkflowDraftSnapshot"
    },
    {
      "$ref": "#/$defs/WireParseFailure"
    },
    {
      "$ref": "#/$defs/AuthoringCommandRejected"
    }
  ],
  "title": "AuthoringWireDocument"
}
