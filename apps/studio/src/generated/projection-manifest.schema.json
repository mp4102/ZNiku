{
  "$defs": {
    "ProjectionFile": {
      "additionalProperties": false,
      "description": "绑定一个生成文件的仓库相对路径与原始字节 digest。",
      "properties": {
        "file_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "File Digest",
          "type": "string"
        },
        "path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "file_digest"
      ],
      "title": "ProjectionFile",
      "type": "object"
    },
    "ProjectionSourceSchema": {
      "additionalProperties": false,
      "description": "绑定一个 Python source Schema 的逻辑名称与 JCS digest。",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "schema_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Schema Digest",
          "type": "string"
        }
      },
      "required": [
        "name",
        "schema_digest"
      ],
      "title": "ProjectionSourceSchema",
      "type": "object"
    }
  },
  "$id": "urn:zniku:schema:projection-manifest:0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "记录 Python→Studio 投影的版本、source digest 与确定文件清单。",
  "properties": {
    "authoring_contract_version": {
      "const": "0.1.0",
      "title": "Authoring Contract Version",
      "type": "string"
    },
    "compiler_contract_version": {
      "const": "0.1.0",
      "title": "Compiler Contract Version",
      "type": "string"
    },
    "core_node_contract_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Core Node Contract Digest",
      "type": "string"
    },
    "diagnostic_contract_version": {
      "const": "0.1.0",
      "title": "Diagnostic Contract Version",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ProjectionFile"
      },
      "title": "Files",
      "type": "array"
    },
    "generator_version": {
      "const": "zniku-projection/0.1.0",
      "title": "Generator Version",
      "type": "string"
    },
    "projection_contract_version": {
      "const": "0.1.0",
      "title": "Projection Contract Version",
      "type": "string"
    },
    "source_schemas": {
      "items": {
        "$ref": "#/$defs/ProjectionSourceSchema"
      },
      "title": "Source Schemas",
      "type": "array"
    },
    "workflow_contract_version": {
      "const": "0.1.0",
      "title": "Workflow Contract Version",
      "type": "string"
    }
  },
  "required": [
    "projection_contract_version",
    "workflow_contract_version",
    "authoring_contract_version",
    "compiler_contract_version",
    "diagnostic_contract_version",
    "generator_version",
    "core_node_contract_digest",
    "source_schemas",
    "files"
  ],
  "title": "ProjectionManifest",
  "type": "object"
}
