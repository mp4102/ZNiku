{
  "$defs": {
    "ArtifactType": {
      "description": "Artifact 的顶层语义类别。",
      "enum": [
        "media",
        "metadata",
        "control"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "Cardinality": {
      "description": "端口绑定单值、可选单值或正式集合。",
      "enum": [
        "one",
        "optional",
        "set"
      ],
      "title": "Cardinality",
      "type": "string"
    },
    "EngineInputContract": {
      "additionalProperties": false,
      "description": "将输入 PortSpec 与 Artifact 属性前置条件绑定。",
      "properties": {
        "port": {
          "$ref": "#/$defs/PortSpec"
        },
        "preconditions_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Preconditions Schema",
          "type": "object"
        }
      },
      "required": [
        "port"
      ],
      "title": "EngineInputContract",
      "type": "object"
    },
    "EngineLifecycleCapabilities": {
      "additionalProperties": false,
      "description": "显式声明 Engine 是否提供验收、发布与恢复集成能力。",
      "properties": {
        "supports_acceptance": {
          "title": "Supports Acceptance",
          "type": "boolean"
        },
        "supports_publication": {
          "title": "Supports Publication",
          "type": "boolean"
        },
        "supports_recovery": {
          "title": "Supports Recovery",
          "type": "boolean"
        }
      },
      "required": [
        "supports_acceptance",
        "supports_publication",
        "supports_recovery"
      ],
      "title": "EngineLifecycleCapabilities",
      "type": "object"
    },
    "EngineOutputContract": {
      "additionalProperties": false,
      "description": "将输出 PortSpec、Artifact 属性保证和媒体属性变化声明绑定。",
      "properties": {
        "attribute_rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MediaAttributeRule"
          },
          "title": "Attribute Rules",
          "type": "array"
        },
        "guarantees_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Guarantees Schema",
          "type": "object"
        },
        "port": {
          "$ref": "#/$defs/PortSpec"
        }
      },
      "required": [
        "port"
      ],
      "title": "EngineOutputContract",
      "type": "object"
    },
    "ExecutionMode": {
      "description": "首批 Engine 执行方式；远程执行尚未进入合同。",
      "enum": [
        "automatic",
        "manual_external"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "JsonValue": {},
    "MediaAttributeDisposition": {
      "description": "Engine 对某个输出媒体属性的声明。",
      "enum": [
        "preserved",
        "changed",
        "not_guaranteed"
      ],
      "title": "MediaAttributeDisposition",
      "type": "string"
    },
    "MediaAttributeRule": {
      "additionalProperties": false,
      "description": "说明一个输出属性保持、改变或无法保证。",
      "properties": {
        "disposition": {
          "$ref": "#/$defs/MediaAttributeDisposition"
        },
        "path": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
          "title": "Path",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaAttributeSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "path",
        "disposition"
      ],
      "title": "MediaAttributeRule",
      "type": "object"
    },
    "MediaAttributeSource": {
      "additionalProperties": false,
      "description": "指出输出属性声明所引用的直接输入端口与属性路径。",
      "properties": {
        "path": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
          "title": "Path",
          "type": "string"
        },
        "port_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Port Id",
          "type": "string"
        }
      },
      "required": [
        "port_id",
        "path"
      ],
      "title": "MediaAttributeSource",
      "type": "object"
    },
    "MediaKind": {
      "description": "媒体 Artifact 的首批受控媒体类别。",
      "enum": [
        "program_media",
        "video",
        "audio",
        "subtitle",
        "attachment"
      ],
      "title": "MediaKind",
      "type": "string"
    },
    "PortSpec": {
      "additionalProperties": false,
      "description": "Engine 端口的稳定 ID、类型、scope 与基数声明。",
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "cardinality": {
          "$ref": "#/$defs/Cardinality"
        },
        "media_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "port_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Port Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "port_id",
        "artifact_type",
        "media_kind",
        "scope",
        "cardinality"
      ],
      "title": "PortSpec",
      "type": "object"
    },
    "Scope": {
      "description": "Artifact 或 Engine 端口的处理范围。",
      "enum": [
        "program",
        "chapter",
        "leaf"
      ],
      "title": "Scope",
      "type": "string"
    }
  },
  "$id": "urn:zniku:schema:engine-manifest:0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Engine 身份、版本、端口、scope、参数与声明式媒体能力的唯一合同。",
  "properties": {
    "contract_version": {
      "const": "0.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "display_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "engine_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
      "title": "Engine Id",
      "type": "string"
    },
    "engine_version": {
      "maxLength": 128,
      "minLength": 5,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "title": "Engine Version",
      "type": "string"
    },
    "execution_mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/EngineInputContract"
      },
      "title": "Inputs",
      "type": "array"
    },
    "lifecycle": {
      "$ref": "#/$defs/EngineLifecycleCapabilities"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/EngineOutputContract"
      },
      "title": "Outputs",
      "type": "array"
    },
    "parameter_schema": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Parameter Schema",
      "type": "object"
    },
    "supported_scopes": {
      "items": {
        "$ref": "#/$defs/Scope"
      },
      "title": "Supported Scopes",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "engine_id",
    "engine_version",
    "display_name",
    "execution_mode",
    "lifecycle",
    "supported_scopes",
    "inputs",
    "outputs",
    "parameter_schema"
  ],
  "title": "EngineManifest",
  "type": "object"
}
