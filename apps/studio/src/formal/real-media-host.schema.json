{
  "$defs": {
    "RealMonitorChapter": {
      "additionalProperties": false,
      "properties": {
        "end_frame": {
          "minimum": 1,
          "title": "End Frame",
          "type": "integer"
        },
        "member_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Member Id",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Scope Id",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        }
      },
      "required": [
        "member_id",
        "scope_id",
        "start_frame",
        "end_frame"
      ],
      "title": "RealMonitorChapter",
      "type": "object"
    },
    "RealMonitorHandoff": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "candidate_exists": {
          "title": "Candidate Exists",
          "type": "boolean"
        },
        "candidate_relative_path": {
          "title": "Candidate Relative Path",
          "type": "string"
        },
        "expected_frame_count": {
          "minimum": 1,
          "title": "Expected Frame Count",
          "type": "integer"
        },
        "expected_frame_rate": {
          "title": "Expected Frame Rate",
          "type": "string"
        },
        "fixture_operation": {
          "title": "Fixture Operation",
          "type": "string"
        },
        "handoff_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Handoff Id",
          "type": "string"
        },
        "input_artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Input Artifact Id",
          "type": "string"
        },
        "input_relative_path": {
          "title": "Input Relative Path",
          "type": "string"
        },
        "plan_node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Plan Node Id",
          "type": "string"
        }
      },
      "required": [
        "handoff_id",
        "plan_node_id",
        "attempt",
        "input_artifact_id",
        "input_relative_path",
        "candidate_relative_path",
        "expected_frame_count",
        "expected_frame_rate",
        "fixture_operation",
        "candidate_exists"
      ],
      "title": "RealMonitorHandoff",
      "type": "object"
    },
    "RealMonitorNode": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "evidence_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Id"
        },
        "execution_mode": {
          "enum": [
            "automatic",
            "manual_external",
            "runtime"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "plan_node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Plan Node Id",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "stage_spec_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Stage Spec Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "subject_kind": {
          "title": "Subject Kind",
          "type": "string"
        }
      },
      "required": [
        "plan_node_id",
        "stage_spec_id",
        "subject_kind",
        "scope",
        "execution_mode",
        "state",
        "attempt",
        "evidence_id"
      ],
      "title": "RealMonitorNode",
      "type": "object"
    },
    "RealMonitorProjection": {
      "additionalProperties": false,
      "description": "Studio Run Monitor 的 fresh read model。",
      "properties": {
        "artifact_count": {
          "minimum": 1,
          "title": "Artifact Count",
          "type": "integer"
        },
        "chapter_split_source_second": {
          "const": 30,
          "title": "Chapter Split Source Second",
          "type": "integer"
        },
        "chapters": {
          "items": {
            "$ref": "#/$defs/RealMonitorChapter"
          },
          "title": "Chapters",
          "type": "array"
        },
        "evidence_count": {
          "minimum": 0,
          "title": "Evidence Count",
          "type": "integer"
        },
        "execution_plan_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Execution Plan Digest",
          "type": "string"
        },
        "final_artifact_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Final Artifact Id"
        },
        "final_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Final Digest"
        },
        "final_verified": {
          "title": "Final Verified",
          "type": "boolean"
        },
        "handoffs": {
          "items": {
            "$ref": "#/$defs/RealMonitorHandoff"
          },
          "title": "Handoffs",
          "type": "array"
        },
        "monitor_contract_version": {
          "const": "0.1.0",
          "title": "Monitor Contract Version",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/RealMonitorNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "ready_node_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "title": "Ready Node Ids",
          "type": "array"
        },
        "reference_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Reference Digest",
          "type": "string"
        },
        "reference_filename": {
          "title": "Reference Filename",
          "type": "string"
        },
        "revision_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Revision Id",
          "type": "string"
        },
        "workflow_run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Workflow Run Id",
          "type": "string"
        }
      },
      "required": [
        "monitor_contract_version",
        "workflow_run_id",
        "revision_id",
        "execution_plan_digest",
        "reference_filename",
        "reference_digest",
        "chapter_split_source_second",
        "chapters",
        "nodes",
        "handoffs",
        "ready_node_ids",
        "artifact_count",
        "evidence_count",
        "final_verified",
        "final_artifact_id",
        "final_digest"
      ],
      "title": "RealMonitorProjection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "host 未启动和已启动状态的闭合 union 外壳。",
  "properties": {
    "candidate_exists": {
      "title": "Candidate Exists",
      "type": "boolean"
    },
    "host_contract_version": {
      "const": "0.1.0",
      "title": "Host Contract Version",
      "type": "string"
    },
    "projection": {
      "anyOf": [
        {
          "$ref": "#/$defs/RealMonitorProjection"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "host_contract_version",
    "candidate_exists",
    "projection"
  ],
  "title": "RealHostEnvelope",
  "type": "object"
}
